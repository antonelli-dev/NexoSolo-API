# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase project URL (used to fetch JWKS signing keys for JWT verification)
# Example: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — same as EXPO_PUBLIC_SUPABASE_ANON_KEY in the app.
# Required so the backend can call `/auth/v1/keys` (JWKS); that endpoint returns 401 without apikey.
SUPABASE_ANON_KEY=your-anon-key

# Production: comma-separated origins (required if NODE_ENV=production)
# CORS_ORIGINS=https://your-web-app.com,https://admin.example.com

# Global API rate limit (requests per minute per IP)
# RATE_LIMIT_PER_MIN=120

# Never enable in production. Local/dev only: impersonate user via X-Debug-User-Id header
# ALLOW_DEBUG_USER_IMPERSONATION=false

# AI (Nest `/v1/ai/*`) — provider-agnostic: OpenAI-compatible or Anthropic
# AI_PROVIDER=openai
# AI_PROVIDER=anthropic
# AI_PROVIDER=azure_openai
# AI_API_KEY=
# Optional: override base URL (default OpenAI: https://api.openai.com/v1)
# AI_BASE_URL=
# Optional model id (provider-specific)
# AI_MODEL=
# Azure: set endpoint via AI_BASE_URL or AZURE_OPENAI_ENDPOINT per your deployment

# Resend — `POST /v1/freelance/invoices/:id/send-email`
# RESEND_API_KEY=
# RESEND_FROM="LetraScope <invoices@your-domain.com>"
