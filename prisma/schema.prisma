// RizzUp — database schema (PostgreSQL / Supabase)
// Apply SQL in prisma/migrations/* manually in Supabase, then: npm run prisma:generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Public profile; `id` must match `auth.users.id` (enforced in Supabase SQL migrations).
model Profile {
  id          String   @id @db.Uuid
  email       String?  @db.VarChar(255)
  displayName String?  @map("display_name") @db.VarChar(100)
  avatarUrl   String?  @map("avatar_url") @db.Text
  /// Subscription / entitlements (synced via RevenueCat webhook).
  isPremium    Boolean  @default(false) @map("is_premium")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  freelanceClients  FreelanceClient[]
  freelanceProjects FreelanceProject[]

  subscriptionTier String  @default("free") @map("subscription_tier") @db.VarChar(32)
  niche            String  @default("uxui") @map("niche") @db.VarChar(32)
  expoPushToken    String? @map("expo_push_token") @db.Text
  /// IANA timezone name, e.g. "America/Mexico_City"
  timeZone String @default("UTC") @map("time_zone") @db.VarChar(64)
  /// Preferred local hour (0-23) for invoice reminder pushes
  invoiceReminderLocalHour Int @default(9) @map("invoice_reminder_local_hour")
  /// Last successful claim/send stamp (UTC) for dedupe across hourly cron ticks
  lastInvoiceReminderSentAt DateTime? @map("last_invoice_reminder_sent_at") @db.Timestamptz(6)

  /// Shown on generated invoice/quote PDFs (your freelance business, not the client).
  invoiceBrandName       String? @map("invoice_brand_name") @db.VarChar(160)
  /// Public HTTPS URL to a PNG/SVG/JPEG logo (optional).
  invoiceBrandLogoUrl    String? @map("invoice_brand_logo_url") @db.Text
  invoiceBrandAddress    String? @map("invoice_brand_address") @db.Text
  /// Accent bar color, e.g. #6366f1 (no leading # stored optional — app sends #RRGGBB).
  invoiceBrandAccentHex  String  @default("#6366f1") @map("invoice_brand_accent_hex") @db.VarChar(7)
  invoiceBrandFooter     String? @map("invoice_brand_footer") @db.Text

  userAttachments UserAttachment[]
  budgetExpenses  PersonalBudgetExpense[]
  paymentMethods  UserPaymentMethod[]

  @@map("profiles")
}

/// Per-user payout / checkout configuration (Stripe secret key, bank hints, etc.). Managed via Nest; not exposed to Supabase clients by default.
model UserPaymentMethod {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  type           String   @db.VarChar(16)
  name           String   @db.VarChar(160)
  isActive       Boolean  @default(true) @map("is_active")
  accountDetails Json?    @map("account_details")
  feePercentage  Decimal  @default(0) @map("fee_percentage") @db.Decimal(5, 2)
  feeFixed       Int      @default(0) @map("fee_fixed")
  feeCurrency    String   @default("USD") @map("fee_currency") @db.VarChar(3)
  processingTime String   @default("Instant") @map("processing_time") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_payment_methods")
}

/// User-entered monthly fixed costs (rent, software, etc.) for the in-app finance planner — not tax advice.
model PersonalBudgetExpense {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @db.VarChar(160)
  category  String   @default("other") @map("category") @db.VarChar(32)
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("EUR") @map("currency") @db.VarChar(3)
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_budget_expenses")
}

/// Freelancer CRM — maps to public.clients (Supabase RLS for direct access; Nest uses service role / JWT user filter).
model FreelanceClient {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  whatsapp       String?
  avgPaymentDays Int?      @map("avg_payment_days")
  healthScore    Decimal?  @map("health_score") @db.Decimal(3, 1)
  notes          String?
  /// VAT / tax id for B2B invoicing
  taxId          String?   @map("tax_id") @db.VarChar(64)
  /// Simple tags e.g. retainer, priority
  tags           String[]  @default([])
  /// Tone / brand notes for AI context
  brandVoiceNotes String?  @map("brand_voice_notes") @db.Text
  /// Arbitrary extra fields { "fiscalName": "...", ... }
  customFields   Json?     @map("custom_fields")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects   FreelanceProject[]
  activities ClientActivity[]
  quotes     Quote[]

  @@index([userId])
  @@index([userId, id])
  @@map("clients")
}

model FreelanceProject {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  name       String
  status     String
  deadline   DateTime? @map("deadline") @db.Timestamptz(6)
  value      Decimal?  @db.Decimal(12, 2)
  paidAmount Decimal?  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  /// Longer description / scope text
  description   String?   @map("description") @db.Text
  /// When client accepted written scope (signature flow later)
  acceptedScopeAt DateTime? @map("accepted_scope_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      FreelanceClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices    FreelanceInvoice[]
  deliveries  ProjectDelivery[]

  @@index([userId])
  @@index([clientId])
  @@index([userId, id])
  @@index([userId, clientId])
  @@map("projects")
}

model FreelanceInvoice {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  status    String
  stripeId  String?  @map("stripe_id") @db.Text
  /// Latest Stripe Checkout session id (payment link flow).
  stripeCheckoutSessionId String? @map("stripe_checkout_session_id") @db.Text
  memo      String?
  currency  String   @default("EUR") @map("currency") @db.VarChar(3)
  dueDate   DateTime? @map("due_date") @db.Timestamptz(6)
  invoiceNumber String? @map("invoice_number") @db.VarChar(64)
  lineItems Json?    @map("line_items")
  lastEmailedAt DateTime? @map("last_emailed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments  InvoicePayment[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("invoices")
}

/// File metadata for objects stored in Supabase Storage (`user-files` bucket).
model UserAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String   @map("entity_id") @db.Uuid
  bucketId   String   @default("user-files") @map("bucket_id") @db.VarChar(64)
  objectPath String   @map("object_path") @db.Text
  fileName   String   @map("file_name") @db.VarChar(512)
  mimeType   String?  @map("mime_type") @db.VarChar(128)
  sizeBytes  Int?     @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivery   ProjectDelivery? @relation("ProjectDeliveryAttachments", fields: [entityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("user_attachments")
}

model InvoicePayment {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice FreelanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_payments")
}

model ClientActivity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  kind      String   @db.VarChar(32)
  title     String
  body      String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client FreelanceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([userId, clientId])
  @@map("client_activities")
}

model ProjectDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  version   Int      @default(1)
  label     String
  notes     String?  @db.Text
  status    String   @default("submitted") // submitted, approved, needs_changes
  clientFeedback String? @map("client_feedback") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments UserAttachment[] @relation("ProjectDeliveryAttachments")

  @@index([projectId])
  @@map("project_deliveries")
}

model Quote {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  title      String
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("EUR") @map("currency") @db.VarChar(3)
  status     String    @default("draft") @db.VarChar(32)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  scopeNotes String?   @map("scope_notes") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client FreelanceClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([userId, clientId])
  @@map("quotes")
}

model SavedBrief {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  title     String
  content   String   @db.Text
  aiSummary String?  @map("ai_summary") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("saved_briefs")
}
